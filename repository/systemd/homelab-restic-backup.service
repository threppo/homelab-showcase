[Unit]
Description=Homelab Restic backup to Backblaze B2
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment=HOME=/root
UMask=0077

ExecStart=/usr/local/sbin/homelab-restic-backup.sh

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

TimeoutStartSec=6h
