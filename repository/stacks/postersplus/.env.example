# SANITIZED PUBLIC EXAMPLE: values and paths are not production configuration.
# latest follows upstream dev. This pins the latest build observed on 2026-10-09.
POSTERSPLUS_IMAGE=ghcr.io/umbraprojects/postersplus:latest@sha256:6d4719fbe2dbf628dd4f597ee8932c7e3f5a5782d23c059d67c4f3999002f498
POSTERSPLUS_DATA_DIR=/srv/example-app-data/postersplus
POSTERSPLUS_UI_PORT=8001

# Private server-side keys. Do not put TMDB/MDBList keys in client poster URLs.
TMDB_API_KEY=CHANGE_ME
MDBLIST_API_KEY=CHANGE_ME
ACCESS_KEY=CHANGE_ME_RENDER_SECRET
ADMIN_KEY=CHANGE_ME_SEPARATE_ADMIN_SECRET

# Optional quality integration; actual profile credentials stay private.
# Configure in the dashboard or enter Base64(uuid:password) below.
QUALITY_SOURCE=aiostreams
AIOSTREAMS_URL=
AIOSTREAMS_AUTH=

# Dashboard settings in cache/settings.json override environment values.
